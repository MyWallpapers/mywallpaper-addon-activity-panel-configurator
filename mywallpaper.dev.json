{
  "native": {
    "builds": [
      {
        "id": "windows-x86_64",
        "command": "node",
        "args": [
          "tools/build-candidate.mjs"
        ],
        "cwd": ".",
        "outputs": [
          "native/out/windows-x86_64/companion.exe",
          "native/out/windows-x86_64/LICENSE",
          "native/out/windows-x86_64/THIRD_PARTY_NOTICES.md",
          "native/out/windows-x86_64/notices"
        ],
        "inputs": [
          "src",
          "include",
          "tests",
          "manifest.json",
          "CMakeLists.txt",
          "CMakePresets.json",
          "native",
          "tools",
          "contracts",
          "third_party"
        ]
      }
    ]
  }
}
