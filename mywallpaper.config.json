{
  "native": {
    "builds": [
      {
        "id": "windows-x86_64",
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-File",
          "native/build.ps1"
        ],
        "cwd": ".",
        "outputs": [
          "native/out/windows-x86_64/companion.exe",
          "native/out/windows-x86_64/LICENSE",
          "native/out/windows-x86_64/THIRD_PARTY_NOTICES.md",
          "native/out/windows-x86_64/notices"
        ]
      }
    ]
  }
}
