{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mywallpaper:addon-contract:a18:audio-system:1",
  "title": "audio-system version 1",
  "description": "Add-on-owned public service projection. Contract and offline conformance only; no provider registration or native bridge is installed.",
  "x-service": {
    "name": "audio-system",
    "version": 1,
    "providerAlias": "audio",
    "methods": {
      "snapshot": {
        "input": "snapshotRequest",
        "output": [
          "snapshotResult",
          "readError"
        ]
      },
      "command": {
        "input": "commandRequest",
        "output": [
          "commandResult"
        ]
      },
      "inventory": {
        "input": "inventoryRequest",
        "output": [
          "inventoryResult",
          "readError"
        ]
      }
    },
    "topics": {
      "audio": "audioState",
      "media": "mediaState"
    },
    "limits": {
      "jsonBytes": 65536,
      "retainedBytesPerBrokerSession": 16777216,
      "queuedBytesPerBrokerSession": 16777216,
      "providerInventoryBytesTotal": 16777216,
      "inventoryChunkBytes": 32768,
      "inventoryReadDeadlineMs": 5000,
      "inventoryOutstandingPerConsumer": 1,
      "maximumTimeoutMs": 30000
    },
    "runtimeBinding": "not-connected",
    "contract": "a18/audio-system"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/snapshotRequest"
    },
    {
      "$ref": "#/$defs/snapshotResult"
    },
    {
      "$ref": "#/$defs/audioState"
    },
    {
      "$ref": "#/$defs/mediaState"
    },
    {
      "$ref": "#/$defs/inventoryRequest"
    },
    {
      "$ref": "#/$defs/inventoryResult"
    },
    {
      "$ref": "#/$defs/commandRequest"
    },
    {
      "$ref": "#/$defs/commandResult"
    },
    {
      "$ref": "#/$defs/readError"
    }
  ],
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "localId": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 4096
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "unsupported",
            "stale_generation",
            "stale_revision",
            "stale_session",
            "permission_denied",
            "unavailable",
            "busy",
            "message_too_large",
            "inventory_expired",
            "timeout",
            "cancelled",
            "revoked",
            "native_failure"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "audioCapabilities": {
      "type": "object",
